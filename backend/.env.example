# Copy to .env and fill in. Any OpenAI-compatible provider works; pick ONE block.

# --- OpenRouter (default) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b:free

# --- Groq (free tier) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# --- Google Gemini (free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Ollama (runs on your PC, no key needed; put any text as the key) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_JSON_MODE=true
# LLM_MIN_INTERVAL=0
# LLM_REASONING_EFFORT=

# Seconds between LLM calls (raise it if you hit rate limits)
LLM_MIN_INTERVAL=3.5
# low|medium|high for reasoning models (gpt-oss); leave empty if a provider rejects it
LLM_REASONING_EFFORT=low

SITE_URL=https://isdic.in
MAX_PAGES=80

EMBED_MODEL=all-MiniLM-L6-v2
# Cosine distance above which a vector hit is treated as irrelevant
MAX_DISTANCE=0.65

ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173
